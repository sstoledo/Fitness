# Fitness API environment — copied to .env for local dev

# API server
PORT=4000

# PostgreSQL (matches docker-compose defaults)
DATABASE_URL=postgres://fitness:fitness_dev_password@localhost:5432/fitness

# Redis (reserved for Socket.io adapters in a future task)
REDIS_URL=redis://localhost:6379

# Secrets (placeholder — rotate before any real deployment)
JWT_SECRET=change-me-in-prod
BETTER_AUTH_SECRET=change-me-in-prod