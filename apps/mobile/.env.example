# Mobile environment — copied to .env for local dev
# Public vars are inlined at build time by Expo; prefix must be EXPO_PUBLIC_.

EXPO_PUBLIC_API_URL=http://localhost:4000

# Dev-only mocks (REMOVAL NOTE: delete with the mock branches in src/lib/health.ts,
# src/lib/health-mock.ts and src/lib/challenges.ts):
# EXPO_PUBLIC_USE_CHALLENGE_MOCKS=1  — simulate challenge list/create/join without the backend
# EXPO_PUBLIC_USE_HEALTH_MOCKS=1     — simulate step counts + health permission without a device
# EXPO_PUBLIC_HEALTH_MOCK_PERMISSION=denied — start the health mock with permission refused